# AgencyOS — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit real secrets to Git.

# Database
DATABASE_URL="postgresql://agencyos:agencyos_dev_password@localhost:5432/agencyos?schema=public"

# Better Auth (see ADR-0001)
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Next.js
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NODE_ENV="development"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Object storage (local dev: local disk; production: S3-compatible after approval)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# Email (Phase 0: interface-only; no credentials required locally)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
