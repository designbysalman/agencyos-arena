{
  "name": "AgencyOS \u2014 A Agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "Prisma.prisma"]
    }
  },
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {
      "label": "AgencyOS Preview",
      "onAutoForward": "openPreview",
      "proto": "http"
    },
    "5433": {
      "label": "PostgreSQL (agencyos-a)",
      "onAutoForward": "none",
      "proto": "tcp"
    }
  },
  "postStartCommand": "bash /workspaces/agencyos-arena/scripts/codespaces-start.sh",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt=seccomp=unconfined"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "workspaceFolder": "/workspaces/agencyos-arena",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/agencyos-arena,type=bind",
  "initializeCommand": "echo 'AgencyOS A Agent devcontainer initialized'",
  "postCreateCommand": null
}
